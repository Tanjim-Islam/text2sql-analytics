# Local Postgres via Docker compose (mapped to host 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER_ADMIN=postgres
DB_PASS_ADMIN=

# Runtime read-only role (created by setup_database.py)
DB_USER_RO=ro
DB_PASS_RO=

# Execution limits
QUERY_TIMEOUT_SECONDS=5
ROW_LIMIT=1000

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LOG_LEVEL=INFO

